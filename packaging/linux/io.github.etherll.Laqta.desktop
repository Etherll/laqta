[Desktop Entry]
Type=Application
Name=Laqta
GenericName=Screen Capture
Comment=Capture, record, mark up and share your screen
Exec=/usr/bin/laqta %F
Icon=io.github.etherll.Laqta
Terminal=false
Categories=Graphics;Utility;
Keywords=screenshot;screen recording;capture;annotate;upload;
StartupWMClass=io.github.etherll.Laqta
# Lets KWin hand over screenshots without the pointer drawn in (Plasma's portal always draws it).
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
