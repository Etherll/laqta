{
  "DefaultTaskSettings": {
    "AfterCaptureJob": "SaveImageToFile, CopyImageToClipboard",
    "AfterUploadJob": "CopyURLToClipboard, ShowQRCode",
    "ImageDestination": "Imgur",
    "TextDestination": "Pastebin",
    "FileDestination": "Dropbox",
    "URLShortenerDestination": "BITLY",
    "URLSharingServiceDestination": "Reddit",
    "GeneralSettings": {
      "PlaySoundAfterCapture": true,
      "PlaySoundAfterUpload": false
    },
    "ImageSettings": {
      "ImageFormat": "PNG",
      "ImageJPEGQuality": 90,
      "ImageAutoUseJPEG": true,
      "ImageAutoUseJPEGSize": 2048,
      "FileExistAction": "UniqueName",
      "ImageEffectPresets": []
    },
    "CaptureSettings": {
      "ShowCursor": true,
      "ScreenshotDelay": 0.5,
      "CaptureTransparent": false
    },
    "UploadSettings": {
      "NameFormatPattern": "%y-%mo-%d_%h-%mi-%s",
      "NameFormatPatternActiveWindow": "%pn_%y-%mo-%d_%h-%mi-%s"
    }
  },
  "UseCustomScreenshotsPath": true,
  "CustomScreenshotsPath": "D:\\Screenshots",
  "HistorySaveTasks": false,
  "ImageEffectPresets": [
    {
      "Name": "Warm",
      "Effects": [
        {
          "$type": "ShareX.ImageEffectsLib.Brightness, ShareX.ImageEffectsLib",
          "Value": 0.2,
          "Enabled": true
        },
        {
          "$type": "ShareX.ImageEffectsLib.Sepia, ShareX.ImageEffectsLib",
          "Value": 1,
          "Enabled": false
        },
        {
          "$type": "ShareX.ImageEffectsLib.SomeFutureEffect, ShareX.ImageEffectsLib",
          "Value": 1,
          "Enabled": true
        }
      ]
    }
  ],
  "Themes": [
    {
      "Name": "Dark"
    }
  ]
}
