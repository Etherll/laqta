{
  "Version": "15.0.0",
  "Name": "OneTimeSecret",
  "DestinationType": "TextUploader",
  "RequestMethod": "POST",
  "RequestURL": "https://onetimesecret.com/api/v1/share",
  "Body": "FormUrlEncoded",
  "Arguments": {
    "secret": "{input}"
  },
  "URL": "https://onetimesecret.com/secret/{json:secret_key}",
  "ErrorMessage": "{json:message}"
}
